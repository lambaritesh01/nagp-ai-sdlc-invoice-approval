{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/.venv/Scripts/python.exe",
            "args": [
              "${CLAUDE_PROJECT_DIR}/.claude/hooks/log_event.py",
              "--phase",
              "session"
            ],
            "timeout": 15
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/.venv/Scripts/python.exe",
            "args": [
              "${CLAUDE_PROJECT_DIR}/.claude/hooks/log_event.py",
              "--phase",
              "prompt"
            ],
            "timeout": 15
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/.venv/Scripts/python.exe",
            "args": [
              "${CLAUDE_PROJECT_DIR}/.claude/hooks/log_event.py",
              "--phase",
              "tooling"
            ],
            "timeout": 15,
            "async": true
          }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/.venv/Scripts/python.exe",
            "args": [
              "${CLAUDE_PROJECT_DIR}/.claude/hooks/log_event.py",
              "--phase",
              "turn"
            ],
            "timeout": 15
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/.venv/Scripts/python.exe",
            "args": [
              "${CLAUDE_PROJECT_DIR}/.claude/hooks/log_event.py",
              "--phase",
              "subagent"
            ],
            "timeout": 15
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/.venv/Scripts/python.exe",
            "args": [
              "${CLAUDE_PROJECT_DIR}/.claude/hooks/log_event.py",
              "--phase",
              "subagent"
            ],
            "timeout": 15
          }
        ]
      }
    ]
  }
}
